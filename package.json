{
  "name": "jarrodtran-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude tests/tap-targets.test.ts --exclude tests/generated-images.test.ts --exclude tests/legacy-redirects.test.ts --exclude tests/page-titles.test.ts --exclude tests/theme-no-js.test.ts --exclude tests/no-photo.test.ts --exclude tests/banned-copy.test.ts --exclude tests/writing-output.test.ts --exclude tests/selected-work-layout.test.ts --exclude tests/highlights-layout.test.ts --exclude tests/hero-layout.test.ts",
    "test:banned": "vitest run tests/banned-copy.test.ts",
    "test:tap": "vitest run tests/tap-targets.test.ts tests/selected-work-layout.test.ts tests/highlights-layout.test.ts tests/hero-layout.test.ts",
    "test:writing-output": "vitest run tests/writing-output.test.ts",
    "test:images": "vitest run tests/generated-images.test.ts tests/no-photo.test.ts",
    "test:redirects": "vitest run tests/legacy-redirects.test.ts",
    "test:titles": "vitest run tests/page-titles.test.ts",
    "test:theme": "vitest run tests/theme-no-js.test.ts",
    "a11y": "node scripts/a11y.mjs",
    "size": "node scripts/js-size.mjs",
    "format": "prettier --write .",
    "lhci": "pnpm dlx @lhci/cli@0.15.x autorun"
  },
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
